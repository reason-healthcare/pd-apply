#!/usr/bin/env node

const path = require('path')
const fs = require('fs')
const Item = require('postman-collection').Item

const args = process.argv.slice(2)
if (!args.length) {
  throw new Error('Must provide path to postman file')
}

const postmanFile = path.resolve(path.resolve(args.join(' ')))
const fshResourcesDirectory = path.resolve(path.join(__dirname), '..', 'fsh-generated', 'resources')

let postmanData
try {
  const postmanDataRaw = fs.readFileSync(postmanFile)?.toString()
  postmanData = JSON.parse(postmanDataRaw)
} catch (e) {
  console.log(`Problem reading file ${postmanFile}: ${e}`)
}

const terminologyEndpoint = {
  "name": "terminologyEndpoint",
  "resource": {
    "resourceType": "Endpoint",
    "address": "{{terminologyEndpointAddress}}",
    "status": "active",
    "payloadType": [
      {
        "coding": [
          {
            "code": "terminology"
          }
        ]
      }
    ],
    "connectionType": {
      "code": "{{terminologyEndpointType}}"
    }
  }
}
const contentEndpoint = {
  "name": "contentEndpoint",
  "resource": {
    "resourceType": "Endpoint",
    "address": "{{contentEndpointAddress}}",
    "status": "active",
    "payloadType": [
      {
        "coding": [
          {
            "code": "content"
          }
        ]
      }
    ],
    "connectionType": {
      "code": "{{contentEndpointType}}"
    }
  }
}

const rawResources = fs.readdirSync(fshResourcesDirectory).map(file => {
  try {
    const data = fs.readFileSync(`${fshResourcesDirectory}/${file}`, 'utf-8')
    return data
  } catch (e) {
    console.log(`Problem reading file ${file}: ${e}`)
  }
}).filter(r => r != null)


// Test/Parameters => Body

// Test/ExpectedOutput => script.exec

const items = postmanData?.item?.map(item => {
  const requestBodyRaw = rawResources.find(resource => (item.name + 'Parameters').endsWith(JSON.parse(resource).id) || (item.name + 'Parameters').endsWith(JSON.parse(resource).name))
  const expectedOutput = rawResources.find(resource => (item.name + 'Expected').endsWith(JSON.parse(resource).id) || (item.name + 'Expected').endsWith(JSON.parse(resource).name))
  const {event, body, name} = item
  if (requestBodyRaw != null && expectedOutput != null) {
    requestBodyRaw.parameters?.push(terminologyEndpoint)
    requestBodyRaw.parameters?.push(contentEndpoint)
    const {script} = event[0]
    const testIndex = script.exec.findIndex(line => line.includes('pm.test'))
    const testScriptRaw = script.exec.slice(testIndex)
    if (testScriptRaw != null) {
      const script = `const expected = ${(expectedOutput)}\n` + testScriptRaw.join('\n')
      const newItem = new Item({
        ...item,
        event: [{...event, script: {...script, exec: script}}],
        body: {...body, raw: requestBodyRaw}
      })
      if (Item.isItem(newItem)) {
        return newItem
      } else {
        console.log(`Unable to update postman item ${name}: problem formatting new item`)
      }
    } else {
      console.log(`Unable to update postman item ${name}: problem formatting test script`)
    }
  } else {
    console.log(`Unable to update postman item ${name}: no associated data by resource name or id`)
  }
  return item
})

const newPostmanData = {...postmanData, item: items}

if (newPostmanData != null) {
  try {
    fs.writeFileSync(postmanFile, JSON.stringify(newPostmanData), 'utf-8')
    console.log(`Updated postman collection ${postmanFile}`)
  } catch (e) {
    console.log(`Problem writing to file ${postmanFile}: ${e}`)
  }
}
